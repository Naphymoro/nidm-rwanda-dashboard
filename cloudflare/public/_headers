/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/
  Cache-Control: no-store, must-revalidate

/index.html
  Cache-Control: no-store, must-revalidate

/manual.html
  Cache-Control: no-store, must-revalidate

/manual
  Cache-Control: no-store, must-revalidate

/manual/*
  Cache-Control: no-store, must-revalidate

/academy.html
  Cache-Control: no-store, must-revalidate

/academy
  Cache-Control: no-store, must-revalidate

/academy/*
  Cache-Control: no-store, must-revalidate

/publication.html
  Cache-Control: no-store, must-revalidate

/publication
  Cache-Control: no-store, must-revalidate

/publication/*
  Cache-Control: no-store, must-revalidate

/backend-check.html
  Cache-Control: no-store, must-revalidate

/engine
  Cache-Control: no-store, must-revalidate

/engine/*
  Cache-Control: no-store, must-revalidate

/styles.css
  Cache-Control: public, max-age=300
