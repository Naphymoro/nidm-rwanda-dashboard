# NDIM Engine local configuration
# The desktop app works without editing this file.

# Optional: override the local data folder.
# NDIM_DATA_DIR=C:\Users\YourName\AppData\Roaming\NDIM Engine

# Optional: run in explicit desktop/local-first mode.
NDIM_DESKTOP=1

# Optional: choose the local API port when running uvicorn manually.
NDIM_HOST=127.0.0.1
NDIM_PORT=8010

# Upload safety limit for CSV/PDF imports.
NDIM_MAX_UPLOAD_MB=50

# Optional LLM augmentation keys. Leave blank for deterministic offline fallback.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=

# Optional database override. Leave blank for local SQLite.
DATABASE_URL=

# Hosted web deployment settings. Use these on Cloud Run or another server.
# NDIM_DEPLOYMENT_MODE=cloud
# NDIM_REQUIRE_DATABASE=1
# NDIM_MAX_UPLOAD_MB=20

# Browser origins allowed to call this engine besides localhost (comma-separated, exact https origins).
# Set this to the Cloudflare Pages site that hosts the static engine UI. The API has no authentication,
# so list only sites you control. Wildcards, paths and http are rejected at startup.
# NDIM_ALLOWED_ORIGINS=https://ndim-engine.pages.dev

# Optional research-phase Google repository.
# Drive stores files; Sheets stores the lightweight evidence ledger.
# Leave blank when using local-only or manual SDMX/CSV package export.
NDIM_GOOGLE_REPOSITORY_MODE=manual_package
NDIM_GOOGLE_REPOSITORY_ROOT_NAME=NDIM Master Repository
NDIM_GOOGLE_REPOSITORY_OWNER=
NDIM_GOOGLE_DRIVE_FOLDER_ID=
NDIM_GOOGLE_SHEETS_LEDGER_ID=
NDIM_GOOGLE_APPS_SCRIPT_SYNC_URL=
