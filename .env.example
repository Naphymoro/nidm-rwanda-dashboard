# NDIM Engine local configuration
# The desktop app works without editing this file.

# Optional: override the local data folder.
# NDIM_DATA_DIR=C:\Users\YourName\AppData\Roaming\NDIM Engine

# Optional: run in explicit desktop/local-first mode.
NDIM_DESKTOP=1

# Optional: choose the local API port when running uvicorn manually.
NDIM_HOST=127.0.0.1
NDIM_PORT=8010

# Upload safety limit for CSV/PDF imports.
NDIM_MAX_UPLOAD_MB=50

# Optional LLM augmentation keys. Leave blank for deterministic offline fallback.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=

# Optional database override. Leave blank for local SQLite.
DATABASE_URL=

# Hosted web deployment settings. Use these on Cloud Run or another server.
# NDIM_DEPLOYMENT_MODE=cloud
# NDIM_REQUIRE_DATABASE=1
# NDIM_MAX_UPLOAD_MB=20
